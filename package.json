{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, human-in-the-loop LinkedIn content engine — Phase 1: generation + dedup",
  "bin": {
    "content": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "dev": "tsx src/cli.ts",
    "content": "tsx src/cli.ts",
    "api": "node dist/api/server.js",
    "api:dev": "tsx watch src/api/server.ts",
    "worker": "node dist/worker/index.js",
    "worker:dev": "tsx watch src/worker/index.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "bullmq": "^5.81.4",
    "commander": "^13.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "ulid": "^2.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
