{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, human-in-the-loop LinkedIn content engine — Phase 1: generation + dedup",
  "bin": {
    "content": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "dev": "tsx src/cli.ts",
    "content": "tsx src/cli.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "google-auth-library": "^11.0.2",
    "sqlite-vec": "^0.1.7-alpha.2",
    "ulid": "^2.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
