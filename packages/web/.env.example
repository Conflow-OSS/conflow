# ── The BFF server (packages/web/server) ──────────────────────────
# This is a completely separate .env from packages/server's — the frontend
# build and Vite's dev server never read this or see the token; only the BFF
# does, and it's the only thing that ever talks to the real backend.
BACKEND_URL=http://127.0.0.1:8787   # the real API — packages/server's API_PORT
API_TOKEN=                           # must match packages/server's .env API_TOKEN
PORT=4000                            # what the BFF itself listens on
