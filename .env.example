# ── Generation volume ─────────────────────────────────────────────
GEN_X=6                    # base topics (ignored when a topic list is supplied — its length wins)
GEN_Y=4                    # angles per topic
GEN_Z=2                    # posts per angle   →  total = X * Y * Z
SHORT_FORM_RATIO=0.35      # fraction of the run generated as short-form (300–600 chars)
HOOK_SPLIT=0.5             # fraction of LONG posts using the "questions" hook (rest "callout")

# ── Model channel ─────────────────────────────────────────────────
MODEL_CHANNEL=vertex       # vertex | zai
MODEL_ID=zai-org/glm-4.7-maas   # vertex: <publisher>/<model>-maas   |   zai: glm-4.7

# vertex channel (default) — auth is ADC: run `gcloud auth application-default login`
VERTEX_PROJECT=
VERTEX_LOCATION=global

# zai channel
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ── Embeddings ────────────────────────────────────────────────────
VOYAGE_API_KEY=
EMBED_MODEL=voyage-3.5-lite
EMBED_DIM=1024             # must match the vec_posts dimension; changing it later rebuilds the vector table

# ── Dedup / validation ────────────────────────────────────────────
DEDUP_LEDGER_THRESHOLD=0.85   # cosine, cross-topic + seed + prior runs
DEDUP_SIBLING_THRESHOLD=0.93  # cosine, within the same topic
LENGTH_TOLERANCE=0.15         # fraction outside the format band before flag_length
SUMMARY_MAX_CHARS=180         # card summary length limit (for the future Imejis image cards)

# ── Image cards (Imejis.io) ───────────────────────────────────────
IMEJIS_API_KEY=
IMEJIS_DESIGN_ID=sbOUjiAfOhsl7UfKBtuqU   # the card template
CARD_IMAGE_FORMAT=png
CARD_BATCH_LIMIT=10                       # max posts processed per `content cards` run
CARD_RENDER_DELAY_MS=1100                 # pause between renders (Imejis free tier = 1 req/sec)

# ── Where rendered cards are stored ──────────────────────────────
IMAGE_STORE=minio                        # minio | disk
CARD_DIR=./data/cards                     # used when IMAGE_STORE=disk

# ── Object storage for the rendered cards (MinIO / any S3-compatible) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=content-cards
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL_BASE=http://localhost:9000  # used to build the stored image URL
S3_FORCE_PATH_STYLE=true                   # MinIO needs path-style addressing

# ── Paths / runtime ───────────────────────────────────────────────
DB_PATH=./data/content.db
EXPORT_DIR=./data/exports
LLM_MAX_RETRIES=3
LLM_TIMEOUT_MS=120000        # thinking models (GLM) burn 15–40s per post
LLM_MAX_TOKENS=20000         # headroom for reasoning tokens + the post itself
LLM_TEMPERATURE=0.8          # sampling temperature for a first draft
REGENERATE_TEMPERATURE=0.9   # slightly higher when re-doing a flagged post, for more divergence
RETRY_BASE_MS=500            # base for exponential backoff on model + embedding calls
LOG_LEVEL=info                # debug | info | warn | error
